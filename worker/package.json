{
  "name": "jinder-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Poller service that aggregates job listings into Supabase for Jinder",
  "main": "dist/poller.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only poller.ts",
    "start": "node dist/poller.js",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "node-fetch": "^2.7.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/node-fetch": "^2.6.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
