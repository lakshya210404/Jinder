# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JSearch (RapidAPI) — free tier caps at 200 requests/month; poll interval is
# hardcoded in worker/poller.ts (not env-configurable) to keep this in budget.
JSEARCH_API_KEY=your-rapidapi-key

# Adzuna (developer.adzuna.com) — check your dashboard for your actual quota
# before running unattended; see the note in worker/pollers/adzuna.ts.
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
